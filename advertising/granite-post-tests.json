          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/articles/",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman Test Article\",\n    \"body\": \"This article was created by Postman automated tests.\",\n    \"status\": \"draft\"\n}"
            }
          }
        },
        {
          "name": "Update article",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Update article returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Title was updated', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.title).to.equal('Postman Test Article Updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/articles/{{test_article_slug}}/",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Postman Test Article Updated\"\n}"
            }
          }
        },
        {
          "name": "Get top stories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Top stories returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/articles/top-stories/"
