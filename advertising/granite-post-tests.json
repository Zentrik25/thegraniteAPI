                  "if (json.results.length > 0) {",
                  "    pm.collectionVariables.set('article_slug', json.results[0].slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/articles/"
          }
        },
        {
          "name": "Get article detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Article detail returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Article has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.title).to.be.a('string');",
                  "    pm.expect(json.slug).to.be.a('string');",
                  "    pm.expect(json.body).to.be.a('string');",
                  "    pm.expect(json.status).to.be.a('string');",
                  "});"
