{
  "info": {
    "name": "The Granite Post — API Tests",
    "description": "Complete automated test suite for The Granite Post CMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8000" },
    { "key": "access_token",      "value": "" },
    { "key": "refresh_token",     "value": "" },
    { "key": "article_slug",      "value": "" },
    { "key": "test_article_slug", "value": "" },
    { "key": "comment_id",        "value": "" },
    { "key": "username",          "value": "thegranite" },
    { "key": "password",          "value": "yourpassword" }
  ],
  "item": [
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "Login and get token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has access token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access).to.be.a('string');",
                  "    pm.expect(json.refresh).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('User role is admin', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user.role).to.equal('admin');",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access);",
                  "pm.collectionVariables.set('refresh_token', json.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/token/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Profile returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Profile has username', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.username).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Unauthenticated access returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated returns 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me/"
          }
        },
        {
          "name": "Invalid token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid token returns 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me/",
            "header": [{ "key": "Authorization", "value": "Bearer invalidtoken123" }]
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('New access token returned', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/token/refresh/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "02 — Articles",
      "item": [
        {
          "name": "List articles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Articles list returns 200', function () {",
