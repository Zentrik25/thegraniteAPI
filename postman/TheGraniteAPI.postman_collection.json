    {
      "name": "Articles",
      "item": [
        {
          "name": "Create Draft Article",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_access}}",
                  "type": "string"
