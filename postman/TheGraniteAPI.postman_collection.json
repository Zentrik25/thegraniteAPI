            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{article_title}}\",\n  \"excerpt\": \"This is an end-to-end Postman test article.\",\n  \"body\": \"<p>Testing the backend from Postman.</p>\",\n  \"status\": \"draft\",\n  \"category\": \"{{category_id}}\",\n  \"tags\": [\"{{tag_id}}\"],\n  \"image_url\": \"https://example.com/test.jpg\",\n  \"image_alt\": \"Test image\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/articles/"
          }
        },
        {
          "name": "Find Article By Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.results && json.results[0];",
                  "if (first && first.slug) {",
                  "    pm.environment.set('article_slug', first.slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_access}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/articles/?search={{article_title}}"
          }
        },
        {
          "name": "Publish Article",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_access}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\",\n  \"is_breaking\": true,\n  \"top_story_rank\": 1,\n  \"featured_rank\": 1,\n  \"category\": \"{{category_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
