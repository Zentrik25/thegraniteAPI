{
  "info": {
    "_postman_id": "b3af3d30-6d90-4d1b-88b0-5ef5915eb3d2",
    "name": "The Granite API Local",
    "description": "Import this collection together with `TheGraniteAPI.local.postman_environment.json`.\n\nBase URL: `{{base_url}}`\n\nNotes:\n- Create at least one Category and one Tag in Django admin before running the article publish flow.\n- `List Categories` and `List Tags` store the first returned IDs into environment variables.\n- Reader verification/reset tokens and newsletter confirm/unsubscribe tokens must be copied into the environment if local email delivery is not wired up.\n- Staff credentials are loaded from the environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Smoke Checks",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/"
          }
        },
        {
          "name": "API Root",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/"
          }
        },
        {
          "name": "Swagger Docs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/docs/"
          }
        }
      ]
    },
    {
      "name": "Setup Lookups",
      "item": [
        {
          "name": "List Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "    pm.environment.set('category_id', String(data[0].id));",
                  "    if (data[0].slug) {",
                  "        pm.environment.set('category_slug', data[0].slug);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/categories/"
          }
        },
        {
          "name": "List Tags",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "    pm.environment.set('tag_id', String(data[0].id));",
                  "    if (data[0].slug) {",
                  "        pm.environment.set('tag_slug', data[0].slug);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/tags/"
          }
        }
      ]
    },
    {
      "name": "Staff Auth",
      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.environment.set('staff_access', json.access);",
                  "}",
                  "if (json.refresh) {",
                  "    pm.environment.set('staff_refresh', json.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staff_username}}\",\n  \"password\": \"{{staff_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/token/"
          }
        },
        {
          "name": "Staff Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_access}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me/"
          }
        },
        {
          "name": "Staff Token Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.environment.set('staff_access', json.access);",
                  "}",
                  "if (json.refresh) {",
                  "    pm.environment.set('staff_refresh', json.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{staff_refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/token/refresh/"
          }
        },
        {
          "name": "Staff Token Blacklist (Run Last)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
